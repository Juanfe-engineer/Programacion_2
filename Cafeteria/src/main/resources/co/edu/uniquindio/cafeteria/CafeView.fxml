<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="CafeController" prefHeight="400.0" prefWidth="500.0"
      spacing="15" style="-fx-background-color: #f0f0f0; -fx-padding: 20;">

  <children>
    <!-- Título -->
    <Label text="Calculadora de Café" textAlignment="CENTER">
      <font>
        <Font name="Arial Bold" size="24.0" />
      </font>
    </Label>

    <!-- Ingredientes -->
    <VBox spacing="10">
      <children>
        <Label text="Ingredientes:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

        <HBox spacing="20">
          <children>
            <CheckBox fx:id="lecheCheckBox" text="Leche" />
            <CheckBox fx:id="wiskyCheckBox" text="Wisky" />
          </children>
        </HBox>

        <HBox spacing="20">
          <children>
            <CheckBox fx:id="azucarCheckBox" text="Azúcar" />
            <CheckBox fx:id="canelaCheckBox" text="Canela" />
          </children>
        </HBox>
      </children>
    </VBox>

    <!-- Tipo de café -->
    <VBox spacing="8">
      <children>
        <Label text="Tipo café:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
        <HBox spacing="20">
          <children>
            <RadioButton fx:id="especialRadio" text="Especial" selected="true">
              <toggleGroup>
                <ToggleGroup fx:id="tipoCafeGroup" />
              </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="pasillaRadio" text="Pasilla" toggleGroup="$tipoCafeGroup" />
          </children>
        </HBox>
      </children>
    </VBox>

    <!-- Botones -->
    <HBox spacing="15" alignment="CENTER">
      <children>
        <Button fx:id="calcularButton" onAction="#calcular" text="Calcular"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                prefWidth="100" />
        <Button fx:id="metodoButton" onAction="#mostrarMetodo" text="Método preparación"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"
                prefWidth="150" />
      </children>
    </HBox>

    <!-- Resultados -->
    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ccc; -fx-border-radius: 5;">
      <children>
        <Label fx:id="costoLabel" text="Costo: $0.0" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
        <Label fx:id="ingredientesLabel" text="Ingredientes: " wrapText="true" />
      </children>
    </VBox>

  </children>
</VBox>